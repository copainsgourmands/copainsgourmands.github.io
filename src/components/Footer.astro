---
import { t, url, type Lang } from '../lib/i18n';
import { SITE } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<footer>
  <div class="wrap foot">
    <div>
      <p class="big">{SITE.name}</p>
      <p>{t(lang, 'footer.made')}</p>
      <p class="legal"><a href={url(`${lang}/mentions-legales/`)}>{t(lang, 'legal.title')}</a> · {t(lang, 'footer.nocookies')}</p>
    </div>
    <a class="btn btn-accent" href={SITE.instagram} target="_blank" rel="noopener"><span aria-hidden="true">📸</span> {t(lang, 'footer.follow')} · @{SITE.handle}<span class="sr-only"> {t(lang, 'a11y.newTab')}</span></a>
  </div>
</footer>

<style>
  footer { background: var(--blue-deep); color: #fff; padding: 48px 0; margin-top: 40px; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .big { font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; margin: 0 0 4px; color: #fff; }
  p { margin: 0; color: rgba(255,255,255,.65); }
  .legal { margin-top: 10px; font-size: .85rem; }
  .legal a { color: #fff; }
  .btn:hover { box-shadow: 0 12px 28px -12px rgba(0,0,0,.5); }
</style>
