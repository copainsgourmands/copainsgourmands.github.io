---
// Adresse racine : renvoie vers /fr/ ou /en/ selon la langue du navigateur.
// GitHub Pages ne sait pas rediriger côté serveur : la page porte donc elle-même titre, description et aperçu,
// pour les moteurs et les robots d'aperçu qui n'exécutent pas le JavaScript.
import { url } from '../lib/i18n';
import { ogImage } from '../lib/restaurants';
import { SITE } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const abs = (p: string) => new URL(url(p), Astro.site).href;
const image = ogImage('fr');
const title = 'Copains Gourmands – Nos adresses préférées à Paris et ailleurs';
const description = 'Nos adresses préférées. Paris, et parfois ailleurs. · Our favourite spots in Paris and beyond.';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#02237d" />
    <link rel="alternate" hreflang="fr" href={abs('fr/')} />
    <link rel="alternate" hreflang="en" href={abs('en/')} />
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs('/')} />
    {image && <meta property="og:image" content={abs(image)} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline define:vars={{ base }}>
      const lang = (navigator.language || 'fr').toLowerCase().startsWith('fr') ? 'fr' : 'en';
      location.replace(`${base}/${lang}/`);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${base}/fr/`} /></noscript>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #02237d; color: #fff; font: 600 1.1rem system-ui, sans-serif; }
      a { color: #fff; margin: 0 .4em; }
    </style>
  </head>
  <body>
    <p><a href={`${base}/fr/`}>Français</a> · <a href={`${base}/en/`} lang="en">English</a></p>
  </body>
</html>
