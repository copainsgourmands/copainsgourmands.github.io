---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${base}/fr/`} />
    <title>Redirection…</title>
    <script is:inline define:vars={{ base }}>
      const lang = (navigator.language || 'fr').toLowerCase().startsWith('fr') ? 'fr' : 'en';
      location.replace(`${base}/${lang}/`);
    </script>
  </head>
  <body style="background:#02237d"></body>
</html>
