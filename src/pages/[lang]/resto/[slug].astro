---
import Base from '../../../layouts/Base.astro';
import StarRating from '../../../components/StarRating.astro';
import RestaurantCard from '../../../components/RestaurantCard.astro';
import MapView from '../../../components/MapView.astro';
import { t, tf, url, colon, LANGS, formatMonth, type Lang } from '../../../lib/i18n';
import { restaurants, areaLabel, mapPoints, isSponsored, reviewIn, reviewText, cuisineLabel, metaDescription, ogImage, type Restaurant } from '../../../lib/restaurants';
import { SITE } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => restaurants.map((r) => ({ params: { lang, slug: r.slug }, props: { r } })));
}

const lang = Astro.params.lang as Lang;
const { r } = Astro.props as { r: Restaurant };
const point = mapPoints(lang).find((p) => p.slug === r.slug);
// Les @mentions de la légende deviennent des liens vers les comptes Instagram.
const sponsored = isSponsored(r);
const reviewParts = reviewText(r, lang).split(/(@[\w.]*\w)/g);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${r.name} ${r.address}`)}`;
const others_addresses = r.other_addresses ?? [];
const name = r.name.replace(/\s+/g, ' ');
const area = areaLabel(r, lang);
const cuisine = cuisineLabel(r.cuisine, lang);
const newTab = t(lang, 'a11y.newTab');

// Données structurées pour Google : l'avis, le restaurant (adresse, position, cuisine…) et le fil d'Ariane.
const abs = (p: string) => new URL(url(p), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Review',
      inLanguage: lang,
      datePublished: r.date,
      url: abs(`${lang}/resto/${r.slug}/`),
      author: { '@type': 'Organization', name: SITE.name, url: abs(`${lang}/`), sameAs: [SITE.instagram] },
      reviewBody: reviewText(r, lang) || undefined,
      itemReviewed: {
        '@type': 'Restaurant',
        name,
        image: r.photos[0] ? abs(r.photos[0]) : undefined,
        servesCuisine: cuisine || undefined,
        priceRange: r.price || undefined,
        address: r.address ? { '@type': 'PostalAddress', streetAddress: r.address, addressLocality: r.city || undefined } : undefined,
        geo: r.lat != null && r.lng != null ? { '@type': 'GeoCoordinates', latitude: r.lat, longitude: r.lng } : undefined,
        sameAs: r.instagram_handle ? [`https://www.instagram.com/${r.instagram_handle}/`] : undefined,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t(lang, 'breadcrumb.home'), item: abs(`${lang}/`) },
        { '@type': 'ListItem', position: 2, name: t(lang, 'nav.catalogue'), item: abs(`${lang}/catalogue/`) },
        { '@type': 'ListItem', position: 3, name },
      ],
    },
  ],
};

// Suggestions : même quartier ou même cuisine, puis les mieux notés.
const others = restaurants
  .filter((o) => o.slug !== r.slug)
  .map((o) => ({ o, score: (o.cuisine === r.cuisine ? 2 : 0) + (o.city === r.city && o.arrondissement === r.arrondissement ? 3 : 0) + (o.rating ?? 0) / 5 }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.o);
---
<Base lang={lang} title={tf(lang, 'seo.resto.title', { name, area })} description={metaDescription(r, lang)}
  image={ogImage(lang, r.slug)} imageAlt={`${name}, ${area}`} type="article" published={r.date} schema={schema}>
  <article class="wrap resto">
    <a class="back link-arrow" href={url(`${lang}/catalogue/`)}>← {t(lang, 'resto.back')}</a>

    <div class="layout">
      <div class="gallery" role="group" aria-roledescription="carousel" aria-label={`${t(lang, 'gallery.label')} – ${name}`}>
        <div class="slides" id="slides" tabindex="0">
          {r.photos.map((p, i) => (
            <img src={url(p)} alt={`${name} – ${i + 1}/${r.photos.length}`} width="900" height="1200" decoding="async"
              loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} />
          ))}
        </div>
        {r.photos.length > 1 && (
          <>
            <button type="button" class="arrow prev" id="prev" aria-label={t(lang, 'gallery.prev')} hidden>‹</button>
            <button type="button" class="arrow next" id="next" aria-label={t(lang, 'gallery.next')}>›</button>
            <p class="counter" aria-live="polite"><span id="current">1</span> / {r.photos.length}</p>
            <div class="dots" id="dots" aria-hidden="true">
              {r.photos.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}
            </div>
          </>
        )}
      </div>

      <div class="info">
        <span class="sticker">{area}</span>
        <h1>{name}</h1>
        <div class="chips">
          {cuisine && <span>{cuisine}</span>}
          {r.price && <span>{r.price}</span>}
          <span>{t(lang, 'resto.visited')} {formatMonth(r.date, lang)}</span>
        </div>

        {sponsored && (
          <p class="collab"><strong><span aria-hidden="true">🤝</span> {t(lang, 'collab.label')}</strong> · {t(lang, 'collab.detail')}</p>
        )}

        {r.rating != null && (
          <div class="rating-box">
            <p class="label">{t(lang, 'resto.myRating')}</p>
            <StarRating rating={r.rating} lang={lang} size="lg" />
          </div>
        )}

        {reviewIn(r, lang) && (
          <div class="review">
            <h2 class="label">{t(lang, 'resto.myReview')}</h2>
            <blockquote>
              {reviewParts.map((part) =>
                part.startsWith('@')
                  ? <a href={`https://www.instagram.com/${part.slice(1)}/`} target="_blank" rel="noopener">{part}<span class="sr-only"> {newTab}</span></a>
                  : part,
              )}
            </blockquote>
          </div>
        )}

        {r.address && <p class="address"><strong>{t(lang, 'resto.address')}{colon(lang)}</strong> {r.address}</p>}
        {others_addresses.length > 0 && (
          <div class="others">
            <p><strong>{t(lang, others_addresses.length > 1 ? 'resto.otherAddresses' : 'resto.otherAddress')}{colon(lang)}</strong></p>
            <ul>{others_addresses.map((a) => <li>{a}</li>)}</ul>
          </div>
        )}
        <div class="actions">
          <a class="btn btn-blue" href={mapsUrl} target="_blank" rel="noopener"><span aria-hidden="true">🧭</span> {t(lang, 'resto.directions')}<span class="sr-only"> {newTab}</span></a>
          {r.instagram_url && <a class="btn btn-accent" href={r.instagram_url} target="_blank" rel="noopener"><span aria-hidden="true">📸</span> {t(lang, 'resto.instagram')}<span class="sr-only"> {newTab}</span></a>}
          {r.instagram_handle && <a class="btn" href={`https://www.instagram.com/${r.instagram_handle}/`} target="_blank" rel="noopener">@{r.instagram_handle}<span class="sr-only"> {newTab}</span></a>}
        </div>
      </div>
    </div>

    {point && (
      <div class="mini-map">
        <MapView points={[point]} lang={lang} height="300px" zoom={15} center={[r.lat!, r.lng!]} cluster={false} embedded />
      </div>
    )}

    {others.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, 'resto.nearby')}</h2></div>
        <div class="grid">{others.map((o) => <RestaurantCard r={o} lang={lang} />)}</div>
      </section>
    )}
  </article>
  <script>
    // Galerie : défilement au doigt, flèches (souris), touches ← → et compteur.
    const slides = document.getElementById('slides');
    const dots = document.querySelectorAll<HTMLElement>('#dots span');
    const prev = document.getElementById('prev') as HTMLButtonElement | null;
    const next = document.getElementById('next') as HTMLButtonElement | null;
    const current = document.getElementById('current');
    if (slides && dots.length) {
      const go = (i: number) => slides.scrollTo({ left: i * slides.clientWidth, behavior: 'smooth' });
      const index = () => Math.round(slides.scrollLeft / slides.clientWidth);
      prev?.addEventListener('click', () => go(index() - 1));
      next?.addEventListener('click', () => go(index() + 1));
      slides.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
      });
      slides.addEventListener('scroll', () => {
        const i = index();
        dots.forEach((d, j) => d.classList.toggle('on', i === j));
        if (current) current.textContent = String(i + 1);
        if (prev) prev.hidden = i === 0;
        if (next) next.hidden = i === dots.length - 1;
      }, { passive: true });
    }
  </script>
</Base>


<style>
  .resto { padding-top: 24px; }
  .back { display: inline-block; margin-bottom: 20px; }
  .layout { display: grid; gap: 28px; }
  @media (min-width: 900px) { .layout { grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; } .layout .gallery { position: sticky; top: 88px; } }
  .gallery { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); position: relative; }
  .slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .slides::-webkit-scrollbar { display: none; }
  .slides img { flex: 0 0 100%; width: 100%; aspect-ratio: 1; object-fit: cover; scroll-snap-align: start; }
  .slides:focus-visible { outline-offset: -4px; }
  .dots { position: absolute; bottom: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 6px; pointer-events: none; }
  .dots span { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.6); transition: width .25s, background-color .25s; box-shadow: 0 1px 4px rgba(0,0,0,.3); }
  .dots span.on { background: #fff; width: 22px; border-radius: 99px; }
  /* Trop de photos pour des points lisibles : le compteur suffit. */
  .dots:has(span:nth-child(9)) { display: none; }
  .counter {
    position: absolute; top: 12px; right: 12px; margin: 0; padding: 3px 10px; border-radius: 999px;
    background: rgba(16, 22, 46, .6); color: #fff; font-size: .8rem; font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .arrow {
    position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; border: 0;
    background: rgba(255, 255, 255, .92); color: var(--blue); font-size: 1.8rem; line-height: 1; padding: 0 0 4px; cursor: pointer;
    box-shadow: 0 4px 14px -4px rgba(0, 0, 0, .45); transition: background-color .2s, transform .2s;
  }
  .arrow:hover { background: #fff; transform: translateY(-50%) scale(1.06); }
  .arrow[hidden] { display: none; }
  .prev { left: 12px; }
  .next { right: 12px; }
  /* Au doigt, on fait glisser les photos : les flèches ne servent qu'à la souris. */
  @media (hover: none) { .arrow { display: none; } }
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin: 14px 0 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips span { border-radius: 999px; padding: 4px 13px; font-size: .85rem; font-weight: 500; color: var(--blue); background: var(--blue-soft); }
  .label { font-family: var(--font-body); line-height: 1.55; text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; font-weight: 700; color: var(--ink-soft); margin: 0 0 6px; }
  .rating-box { margin: 26px 0; padding: 16px 20px; border-radius: var(--radius-sm); background: var(--accent); color: #fff; display: inline-block; }
  .rating-box :global(.fill) { color: #fff; }
  .rating-box :global(.track) { color: rgba(255, 255, 255, .3); }
  blockquote { margin: 0; font-size: 1.15rem; line-height: 1.6; border-left: 3px solid var(--accent); padding-left: 20px; white-space: pre-line; }
  blockquote a { color: var(--blue); font-weight: 700; }
  .chips + .review, .collab + .review { margin-top: 26px; }
  .collab {
    margin: 18px 0 0; padding: 10px 14px; border-radius: var(--radius-sm); font-size: .9rem; line-height: 1.45;
    background: var(--paper-2); border: 1px solid var(--line); color: var(--ink);
  }
  .address { margin: 26px 0 16px; color: var(--ink-soft); }
  .others { margin: -6px 0 16px; color: var(--ink-soft); }
  .others p { margin: 0 0 4px; }
  .others ul { margin: 0; padding-left: 20px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .mini-map { margin-top: 48px; }
</style>
